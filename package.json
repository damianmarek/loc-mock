{
  "name": "loc-mock",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "3",
    "tailwindcss-animate": "^1.0.7",
    "vite": "6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "^1.18.0",
    "lucide-react": "^1.17.0",
    "maplibre-gl": "^5.24.0",
    "react": "18",
    "react-dom": "18",
    "react-map-gl": "^8.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "scripts": {
    "dev": "electrobun dev",
    "dev:hmr": "concurrently -k \"vite --port 5173\" \"electrobun dev\"",
    "build:web": "vite build",
    "build": "vite build && electrobun build",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable",
    "package:dmg": "bun scripts/package-dmg.ts",
    "release:local": "bun run build && bun run package:dmg",
    "start": "vite build && electrobun dev"
  }
}
